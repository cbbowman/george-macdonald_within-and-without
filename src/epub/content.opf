		<meta property="file-as" refines="#subtitle">Dramatic Poem, A</meta>
		<meta property="title-type" refines="#subtitle">subtitle</meta>
		<dc:title id="fulltitle">Within and Without: A Dramatic Poem</dc:title>
		<meta property="file-as" refines="#fulltitle">Within and Without</meta>
		<meta property="title-type" refines="#fulltitle">expanded</meta>
